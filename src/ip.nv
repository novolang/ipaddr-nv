// ip.nv — an IP address as a number you can hold in a register.
//
// THE MODULE IS `ip` AND THE PACKAGE IS `ipaddr-nv`
//
// The package keeps the name of the thing it is a port of — Python's
// `ipaddress` — with the `-nv` suffix every port carries.  The module
// is `ip` because that is the shorter true name and because a module
// basename may not shadow a standard-library one: `std.net` already
// exists, so a module called `net` inside this package would silently
// take that name away from every program that depended on it.
//
// WHAT AN ADDRESS IS HERE
//
// An `Ipv4` is one 32-bit number and an `Ipv6` is two 64-bit halves.
// Both are `@value` structs (SPEC § 14): copied on every binding and
// every call, laid out on the stack or in `.bss` with no header and no
// reference count.  Nothing in this file allocates — not the parsers,
// not the classification, not the formatters, which write into a
// buffer their caller already owns.
//
// WHY THAT IS A MODULE BOUNDARY AND NOT A NAMING CONVENTION
//
// Novo has no `[alloc]` effect to hang the promise on.  SPEC § 5.1's
// effect vocabulary is exhaustive and a clause naming `alloc` is
// `E3005`, so a function cannot declare that it allocates and the
// compiler cannot check that it does not.  The line is drawn as a
// module boundary instead, which a build either crosses or does not:
//
//   ip, cidr   never allocate.  Addresses, networks, the arithmetic
//              over them, the parsers, and formatting into a `Bytes`
//              the caller supplied.
//   show       always allocates.  It is the only module that returns
//              a `Str`, and it returns nothing else.
//
// A program that never writes `use show` never links an allocation
// this package asked for.
//
// WHAT REACHES A MICROCONTROLLER
//
// Everything here that is `Int` algebra — construction from octets,
// the accessors, the comparisons, every classification predicate —
// cross-compiles for `--target=nrf52-qemu` and runs with no heap.
//
// The calls that read a `Str` or write a `Bytes` carry `@tier(app)`,
// and a device build prunes them.  That is not a style choice: the
// embedded runtime defines no `novo_bytes_*` symbol at all and no
// `novo_str_byte_at`, so on a device an address can be held, computed
// on and compared, and cannot be read out of text or written into a
// buffer.  The two filings are
// `no-embedded-byte-read-of-a-str` (the tier refusal) and
// `no-embedded-str-byte-read-at-rt-tier` (the
// link failure one tier up).  When they close, the annotations come
// off and the whole module compiles for a device.
//
// WHAT IT FOLLOWS
//
// Parsing takes the forms RFC 4291 § 2.2 defines and refuses what
// CPython's `ipaddress` refuses, byte for byte, including the leading
// zero that `inet_aton` would have read as octal.  Formatting follows
// RFC 5952 § 4 and § 5.  Classification follows the special-purpose
// registry as CPython 3.10 encodes it.
//
// WHAT IT DOES NOT DO
//
// No zone identifiers: `fe80::1%eth0` is `ZoneUnsupported`, not an
// address with a scope.  A zone is an interface name — text — and a
// `@value` struct holds scalars only (SPEC § 14.2), so carrying one
// would mean either allocating or giving the address type a span into
// a string it does not own.  Python has accepted them since 3.9 and
// this is the one place the package is deliberately narrower.
//
// No dotted netmasks (`192.0.2.0/255.255.255.0`) and no host-shorthand
// (`127.1`).  Python refuses the second too; the first it accepts and
// `cidr` does not — see that module.

use std.bits
use std.str
use std.bytes

// ── the bytes this module names ──────────────────────────────────────
//
// Spelled once, at the top, because a scanner comparing against `58` is
// a scanner nobody can review.

const PERCENT: Int = 37
const DOT: Int = 46
const D_ZERO: Int = 48
const D_NINE: Int = 57
const COLON: Int = 58
const UPPER_A: Int = 65
const UPPER_F: Int = 70
const LOWER_A: Int = 97
const LOWER_F: Int = 102

// ── the codes a parse result carries ─────────────────────────────────
//
// A `@value` struct holds scalars only (SPEC § 14.2), so the reason a
// parse failed rides in the struct as an `Int` and is read back out as
// an `IpError` by `error_of`.  These constants are private: the codes
// are an implementation detail and the enum is the surface.

const E_OK: Int = 0
const E_EMPTY: Int = 1
const E_BAD_CHARACTER: Int = 2
const E_WRONG_PART_COUNT: Int = 3
const E_PART_TOO_LONG: Int = 4
const E_EMPTY_PART: Int = 5
const E_LEADING_ZERO: Int = 6
const E_OCTET_RANGE: Int = 7
const E_REPEATED_DOUBLE_COLON: Int = 8
const E_LONE_COLON: Int = 9
const E_ZONE: Int = 10
const E_BAD_PREFIX: Int = 11
const E_HOST_BITS: Int = 12
const E_NETMASK_FORM: Int = 13

// Why a parse did not produce an address or a network.
//
// One variant per way the input was not the thing it claimed to be, so
// a caller can tell "your octet is 300" from "you wrote a zone id"
// and say something useful about either.  `show.reason` turns one into
// a sentence.
pub enum IpError
    // The input named no bytes at all.
    Empty
    // A byte stands where the grammar admits none: a letter in a
    // dotted quad, a `g` in a hex group, a space anywhere.
    BadCharacter
    // Not four octets, not the eight groups an IPv6 address needs, or
    // more colon-separated parts than one can hold.
    WrongPartCount
    // An octet written with more than three digits, or a hex group
    // with more than four.
    PartTooLong
    // Two separators with nothing between them where `::` is not what
    // that means — `192.0..1`, or a `/` with no prefix after it.
    EmptyPart
    // An octet written with a leading zero, which `inet_aton` would
    // have read as octal and which every modern parser refuses
    // outright rather than guess at.
    LeadingZero
    // An octet above 255.
    OctetOutOfRange
    // `::` appears more than once, so the run of zeros it stands for
    // is not determined.
    RepeatedDoubleColon
    // A single `:` at the start or the end of an IPv6 address, which
    // is only legal as half of a `::`.
    LoneColon
    // The address carries a zone identifier (`fe80::1%eth0`).  This
    // package does not implement scopes — see the module comment.
    ZoneUnsupported
    // The `/` was there and what followed it is not a prefix length in
    // range for the family.
    BadPrefixLength
    // A network was written with bits set below its prefix
    // (`192.0.2.5/24`) and the parse was asked to be strict.
    HostBitsSet
    // A network was written with a dotted netmask
    // (`192.0.2.0/255.255.255.0`).  Only `addr/len` is read here.
    NetmaskFormUnsupported

// The reason a code names, or `None` when the code is success.
//
// The `err` field of every parse result in this package is one of
// these codes.  Prefer the `error()` method on the result — this is
// the function it calls, exposed because `cidr` calls it too.
//
// ```novo
// use ip
//
// fn main() [io]
//     let p = ip.parse_ipv4("10.0.0.300")
//     match ip.error_of(p.err)
//         Some(OctetOutOfRange) => println("out of range")
//         Some(_)               => println("some other reason")
//         None                  => println("it parsed")
// ```
pub fn error_of(code: Int) -> ?IpError
    if code == E_EMPTY
        Some(Empty)
    else if code == E_BAD_CHARACTER
        Some(BadCharacter)
    else if code == E_WRONG_PART_COUNT
        Some(WrongPartCount)
    else if code == E_PART_TOO_LONG
        Some(PartTooLong)
    else if code == E_EMPTY_PART
        Some(EmptyPart)
    else if code == E_LEADING_ZERO
        Some(LeadingZero)
    else if code == E_OCTET_RANGE
        Some(OctetOutOfRange)
    else if code == E_REPEATED_DOUBLE_COLON
        Some(RepeatedDoubleColon)
    else if code == E_LONE_COLON
        Some(LoneColon)
    else if code == E_ZONE
        Some(ZoneUnsupported)
    else if code == E_BAD_PREFIX
        Some(BadPrefixLength)
    else if code == E_HOST_BITS
        Some(HostBitsSet)
    else if code == E_NETMASK_FORM
        Some(NetmaskFormUnsupported)
    else
        None

// ── the two address types ────────────────────────────────────────────

// An IPv4 address: four octets, held as the 32-bit number they spell.
//
// `raw` is in `0 ..= 4294967295`, big-endian — `192.0.2.1` is
// `0xC0000201`, so the first octet is the most significant byte.  That
// is the number `inet_addr` returns in host order and the one a
// netmask is applied to, which is why it is the representation rather
// than four separate fields.
//
// Read octets back with `octet`; build one with `ipv4` or
// `ipv4_from_int`.
pub @value
struct Ipv4
    raw: Int

// An IPv6 address: sixteen octets, held as two 64-bit halves.
//
// `hi` is octets 0 to 7 and `lo` is octets 8 to 15, each big-endian —
// `2001:db8::1` has `hi` = `0x20010db800000000` and `lo` = `1`.  Both
// are bit patterns, not numbers: a half with its top bit set reads as
// a negative `Int` and only `cmp` gives the ordering an address has.
//
// Read groups back with `group` and octets with `octet`; build one
// with `ipv6`, `ipv6_from_halves` or `ipv4_mapped`.
pub @value
struct Ipv6
    hi: Int
    lo: Int

// What `parse_ipv4` answers: an address, or the reason there is none.
//
// `?Ipv4` is not a type this language has — SPEC § 14.5 rejects a
// `@value` struct as an optional payload, because the payload lives in
// a heap cell and the whole point of the struct is that it does not.
// So the reason travels beside the address in the same unboxed value,
// and `addr` is the zero address when `is_ok()` is false.
pub @value
struct Ipv4Parse
    err: Int
    addr: Ipv4

// What `parse_ipv6` answers, on the same shape as `Ipv4Parse`.
pub @value
struct Ipv6Parse
    err: Int
    addr: Ipv6

impl Ipv4Parse
    // True when the input was an IPv4 address.
    @tier(embedded)
    fn is_ok(self) -> Bool
        self.err == E_OK

    // Why it was not, or `None` when it was.
    fn error(self) -> ?IpError
        error_of(self.err)

impl Ipv6Parse
    // True when the input was an IPv6 address.
    @tier(embedded)
    fn is_ok(self) -> Bool
        self.err == E_OK

    // Why it was not, or `None` when it was.
    fn error(self) -> ?IpError
        error_of(self.err)

// ── bit helpers ──────────────────────────────────────────────────────

// The low 32 bits of `x`.
@tier(embedded)
fn low32(x: Int) -> Int
    bits.band(x, 0xFFFFFFFF)

// A 32-bit mask with the top `p` bits set, for `p` in `0 ..= 32`.
//
// `p == 0` gives 0 and `p == 32` gives `0xFFFFFFFF`; the shift by 32
// falls off the top of the 64-bit word and the mask cleans up after
// it, so neither end needs a case of its own.
@tier(embedded)
fn mask32(p: Int) -> Int
    low32(bits.shl(0xFFFFFFFF, 32 - p))

// A 64-bit mask with the top `k` bits set.
//
// `k` outside `0 ..= 64` saturates, which is what the two halves of an
// IPv6 prefix want: the high half asks for `mask64(prefix)` and the
// low half for `mask64(prefix - 64)`, and one of those is out of range
// for every prefix.
@tier(embedded)
fn mask64(k: Int) -> Int
    if k <= 0
        0
    else if k >= 64
        bits.bnot(0)
    else
        bits.shl(bits.bnot(0), 64 - k)

// The 64-bit half four 16-bit groups spell, most significant first.
@tier(embedded)
fn half(g0: Int, g1: Int, g2: Int, g3: Int) -> Int
    bits.bor(bits.bor(bits.shl(g0, 48), bits.shl(g1, 32)),
             bits.bor(bits.shl(g2, 16), g3))

// Compare two 64-bit words as UNSIGNED: `-1`, `0` or `1`.
//
// `Int` comparison is signed and a half with its top bit set is
// negative, so `ff00:: < ::1` would be the answer without this.
// Flipping the sign bit of both operands maps the unsigned order onto
// the signed one exactly.
@tier(embedded)
fn cmp_u64(a: Int, b: Int) -> Int
    let fa = bits.xor(a, bits.shl(1, 63))
    let fb = bits.xor(b, bits.shl(1, 63))
    if fa < fb
        -1
    else if fa > fb
        1
    else
        0

// ── Ipv4 ─────────────────────────────────────────────────────────────

impl Ipv4
    // Octet `i`, counting from the left: `octet(0)` of `192.0.2.1` is
    // `192`.  An index outside `0 ..= 3` answers 0.
    @tier(embedded)
    fn octet(self, i: Int) -> Int
        if i < 0 or i > 3
            0
        else
            bits.band(bits.shr(self.raw, 24 - 8 * i), 0xFF)

    // The address as the 32-bit number it spells, in `0 ..= 4294967295`.
    @tier(embedded)
    fn to_int(self) -> Int
        self.raw

    // True when the two addresses are the same one.
    //
    // A method rather than `==`: SPEC § 14.5 rejects a `@value` struct
    // as an operand of the comparison operators, so the type has to
    // say it itself.
    @tier(embedded)
    fn eq(self, other: Ipv4) -> Bool
        self.raw == other.raw

    // `-1`, `0` or `1` as this address sorts before, with, or after
    // `other` — the numeric order, which is also the order a routing
    // table wants.
    @tier(embedded)
    fn cmp(self, other: Ipv4) -> Int
        if self.raw < other.raw
            -1
        else if self.raw > other.raw
            1
        else
            0

    // True for `0.0.0.0`, the address that names no host.
    @tier(embedded)
    fn is_unspecified(self) -> Bool
        self.raw == 0

    // True inside `127.0.0.0/8`.
    @tier(embedded)
    fn is_loopback(self) -> Bool
        in4(self.raw, 0x7F000000, 8)

    // True inside `169.254.0.0/16`, the block a host gives itself when
    // no DHCP server answered.
    @tier(embedded)
    fn is_link_local(self) -> Bool
        in4(self.raw, 0xA9FE0000, 16)

    // True inside `224.0.0.0/4`.
    @tier(embedded)
    fn is_multicast(self) -> Bool
        in4(self.raw, 0xE0000000, 4)

    // True for `255.255.255.255`, the limited broadcast address.
    @tier(embedded)
    fn is_broadcast(self) -> Bool
        self.raw == 0xFFFFFFFF

    // True inside `240.0.0.0/4`, reserved by RFC 1112 § 4 and never
    // allocated.
    @tier(embedded)
    fn is_reserved(self) -> Bool
        in4(self.raw, 0xF0000000, 4)

    // True inside TEST-NET-1, TEST-NET-2 or TEST-NET-3 — `192.0.2.0/24`,
    // `198.51.100.0/24` and `203.0.113.0/24`, the three blocks RFC 5737
    // set aside for documentation and examples.
    @tier(embedded)
    fn is_documentation(self) -> Bool
        in4(self.raw, 0xC0000200, 24)
            or in4(self.raw, 0xC6336400, 24)
            or in4(self.raw, 0xCB007100, 24)

    // True when the address is not globally routable, by the
    // special-purpose registry RFC 6890 keeps and CPython 3.10 encodes
    // as `IPv4Address._constants._private_networks`.
    //
    // Twelve blocks, and they are the whole definition:
    //
    //   0.0.0.0/8        "this network"
    //   10.0.0.0/8       private use
    //   127.0.0.0/8      loopback
    //   169.254.0.0/16   link local
    //   172.16.0.0/12    private use
    //   192.0.0.0/24     IETF protocol assignments
    //   192.0.2.0/24     TEST-NET-1
    //   192.168.0.0/16   private use
    //   198.18.0.0/15    benchmarking
    //   198.51.100.0/24  TEST-NET-2
    //   203.0.113.0/24   TEST-NET-3
    //   240.0.0.0/4      reserved
    //
    // CPython's list also carries `192.0.0.170/31` and
    // `255.255.255.255/32`; both sit inside a block already listed
    // (`192.0.0.0/24` and `240.0.0.0/4`), so repeating them here would
    // add a line and no address.  Later CPython releases have added
    // further blocks — 3.10 is the version this package is checked
    // against and the README says so.
    @tier(embedded)
    fn is_private(self) -> Bool
        in4(self.raw, 0x00000000, 8)
            or in4(self.raw, 0x0A000000, 8)
            or in4(self.raw, 0x7F000000, 8)
            or in4(self.raw, 0xA9FE0000, 16)
            or in4(self.raw, 0xAC100000, 12)
            or in4(self.raw, 0xC0000000, 24)
            or in4(self.raw, 0xC0000200, 24)
            or in4(self.raw, 0xC0A80000, 16)
            or in4(self.raw, 0xC6120000, 15)
            or in4(self.raw, 0xC6336400, 24)
            or in4(self.raw, 0xCB007100, 24)
            or in4(self.raw, 0xF0000000, 4)

// True when `raw` lies in the block `net/prefix`.  `net` is expected
// already masked, which every caller above writes out in full.
@tier(embedded)
fn in4(raw: Int, net: Int, prefix: Int) -> Bool
    bits.band(raw, mask32(prefix)) == net

// The address the four octets spell.
//
// Each argument is a byte: a value outside `0 ..= 255` is masked to
// its low eight bits, the same truncation `as u8` performs (SPEC
// § 13.3).  The constructor is total on purpose — a caller that has
// four bytes out of a packet header has an address, not a question.
//
// ```novo
// use ip
//
// fn main() [io]
//     let a = ip.ipv4(192, 0, 2, 1)
//     println("${a.to_int()}")        // 3221225985
//     println("${a.octet(0)}")        // 192
// ```
pub @tier(embedded)
fn ipv4(a: Int, b: Int, c: Int, d: Int) -> Ipv4
    Ipv4 { raw: bits.bor(bits.bor(bits.shl(bits.band(a, 0xFF), 24),
                                 bits.shl(bits.band(b, 0xFF), 16)),
                         bits.bor(bits.shl(bits.band(c, 0xFF), 8),
                                  bits.band(d, 0xFF))) }

// The address a 32-bit number spells, masked to its low 32 bits.
//
// The inverse of `to_int`.
pub @tier(embedded)
fn ipv4_from_int(v: Int) -> Ipv4
    Ipv4 { raw: low32(v) }

// The all-zero IPv4 address, `0.0.0.0`.
//
// What a failed `parse_ipv4` carries, and the identity a caller can
// start an accumulation from.
pub @tier(embedded)
fn ipv4_zero() -> Ipv4
    Ipv4 { raw: 0 }

// ── Ipv6 ─────────────────────────────────────────────────────────────

impl Ipv6
    // Group `i`, counting from the left: `group(0)` of `2001:db8::1`
    // is `0x2001`.  An index outside `0 ..= 7` answers 0.
    @tier(embedded)
    fn group(self, i: Int) -> Int
        if i < 0 or i > 7
            0
        else if i < 4
            bits.band(bits.shr(self.hi, 48 - 16 * i), 0xFFFF)
        else
            bits.band(bits.shr(self.lo, 48 - 16 * (i - 4)), 0xFFFF)

    // Octet `i`, counting from the left.  An index outside `0 ..= 15`
    // answers 0.
    @tier(embedded)
    fn octet(self, i: Int) -> Int
        if i < 0 or i > 15
            0
        else if i < 8
            bits.band(bits.shr(self.hi, 56 - 8 * i), 0xFF)
        else
            bits.band(bits.shr(self.lo, 56 - 8 * (i - 8)), 0xFF)

    // True when the two addresses are the same one.
    @tier(embedded)
    fn eq(self, other: Ipv6) -> Bool
        self.hi == other.hi and self.lo == other.lo

    // `-1`, `0` or `1` as this address sorts before, with, or after
    // `other`, reading all 128 bits as one unsigned number.
    @tier(embedded)
    fn cmp(self, other: Ipv6) -> Int
        let h = cmp_u64(self.hi, other.hi)
        if h != 0
            h
        else
            cmp_u64(self.lo, other.lo)

    // True for `::`.
    @tier(embedded)
    fn is_unspecified(self) -> Bool
        self.hi == 0 and self.lo == 0

    // True for `::1`.
    @tier(embedded)
    fn is_loopback(self) -> Bool
        self.hi == 0 and self.lo == 1

    // True inside `ff00::/8`.
    @tier(embedded)
    fn is_multicast(self) -> Bool
        bits.band(self.group(0), 0xFF00) == 0xFF00

    // True inside `fe80::/10`.
    @tier(embedded)
    fn is_link_local(self) -> Bool
        bits.band(self.group(0), 0xFFC0) == 0xFE80

    // True inside `fec0::/10`, the site-local prefix RFC 3879
    // deprecated in 2004.  Reported because packets carrying one still
    // arrive, not because anything should send one.
    @tier(embedded)
    fn is_site_local(self) -> Bool
        bits.band(self.group(0), 0xFFC0) == 0xFEC0

    // True inside `fc00::/7`, the unique-local block — IPv6's answer
    // to `10.0.0.0/8`.
    @tier(embedded)
    fn is_unique_local(self) -> Bool
        bits.band(self.group(0), 0xFE00) == 0xFC00

    // True inside `2001:db8::/32`, the block RFC 3849 set aside for
    // documentation and examples.
    @tier(embedded)
    fn is_documentation(self) -> Bool
        self.group(0) == 0x2001 and self.group(1) == 0x0DB8

    // True inside `::ffff:0:0/96`, the block that carries an IPv4
    // address through an IPv6 socket.
    @tier(embedded)
    fn is_ipv4_mapped(self) -> Bool
        self.hi == 0 and bits.shr(self.lo, 32) == 0xFFFF

    // The IPv4 address this one carries, when `is_ipv4_mapped()` is
    // true.  Answers `0.0.0.0` when it is not, so check first.
    @tier(embedded)
    fn mapped_ipv4(self) -> Ipv4
        if self.is_ipv4_mapped()
            Ipv4 { raw: low32(self.lo) }
        else
            Ipv4 { raw: 0 }

    // True when the address is not globally routable, by the
    // special-purpose registry as CPython 3.10 encodes it in
    // `IPv6Address._constants._private_networks`.
    //
    // Ten blocks:
    //
    //   ::/128           the unspecified address
    //   ::1/128          loopback
    //   ::ffff:0:0/96    IPv4-mapped
    //   64:ff9b:1::/48   local-use IPv4/IPv6 translation
    //   100::/64         discard-only
    //   2001::/23        IETF protocol assignments
    //   2001:db8::/32    documentation
    //   2002::/16        6to4
    //   fc00::/7         unique local
    //   fe80::/10        link local
    //
    // `2001:db8::/32` is NOT inside `2001::/23` — the /23 fixes the
    // first seven bits of the second group at zero and `0db8` has bits
    // above that — so both lines are load-bearing.
    @tier(embedded)
    fn is_private(self) -> Bool
        self.is_unspecified()
            or self.is_loopback()
            or self.is_ipv4_mapped()
            or in6(self, half(0x0064, 0xFF9B, 0x0001, 0), 0, 48)
            or in6(self, half(0x0100, 0, 0, 0), 0, 64)
            or in6(self, half(0x2001, 0, 0, 0), 0, 23)
            or self.is_documentation()
            or in6(self, half(0x2002, 0, 0, 0), 0, 16)
            or self.is_unique_local()
            or self.is_link_local()

// True when `a` lies in the block whose already-masked halves are
// `net_hi` and `net_lo` and whose prefix is `prefix`.
@tier(embedded)
fn in6(a: Ipv6, net_hi: Int, net_lo: Int, prefix: Int) -> Bool
    bits.band(a.hi, mask64(prefix)) == net_hi
        and bits.band(a.lo, mask64(prefix - 64)) == net_lo

// The address the eight groups spell, most significant first.
//
// Each argument is a 16-bit group; a value outside `0 ..= 65535` is
// masked to its low sixteen bits.
//
// ```novo
// use ip
//
// fn main() [io]
//     let a = ip.ipv6(0x2001, 0x0DB8, 0, 0, 0, 0, 0, 1)
//     println("${a.group(1)}")            // 3512
//     println("${a.is_documentation()}")  // true
// ```
pub @tier(embedded)
fn ipv6(g0: Int, g1: Int, g2: Int, g3: Int,
        g4: Int, g5: Int, g6: Int, g7: Int) -> Ipv6
    Ipv6 { hi: half(bits.band(g0, 0xFFFF), bits.band(g1, 0xFFFF),
                    bits.band(g2, 0xFFFF), bits.band(g3, 0xFFFF)),
           lo: half(bits.band(g4, 0xFFFF), bits.band(g5, 0xFFFF),
                    bits.band(g6, 0xFFFF), bits.band(g7, 0xFFFF)) }

// The address two 64-bit halves spell.
//
// The inverse of reading `hi` and `lo`, and the cheapest way to carry
// an address through a structure that only has room for two words.
pub @tier(embedded)
fn ipv6_from_halves(hi: Int, lo: Int) -> Ipv6
    Ipv6 { hi: hi, lo: lo }

// The all-zero IPv6 address, `::`.
pub @tier(embedded)
fn ipv6_zero() -> Ipv6
    Ipv6 { hi: 0, lo: 0 }

// The IPv4-mapped IPv6 address that carries `a`: `::ffff:a`.
//
// The address an IPv4 peer has when it arrives on a dual-stack socket.
//
// ```novo
// use ip
//
// fn main() [io]
//     let m = ip.ipv4_mapped(ip.ipv4(192, 0, 2, 1))
//     println("${m.is_ipv4_mapped()}")            // true
//     println("${m.mapped_ipv4().octet(3)}")      // 1
// ```
pub @tier(embedded)
fn ipv4_mapped(a: Ipv4) -> Ipv6
    Ipv6 { hi: 0, lo: bits.bor(bits.shl(0xFFFF, 32), a.raw) }

// Push one 16-bit group onto the right of a 128-bit accumulator.
//
// The whole value shifts left by sixteen and the group lands in the
// bottom.  Eight pushes from `ipv6_zero()` build an address; the
// parser is the only caller and does exactly eight.
@tier(embedded)
fn push_group(v: Ipv6, g: Int) -> Ipv6
    Ipv6 { hi: bits.bor(bits.shl(v.hi, 16), bits.shr(v.lo, 48)),
           lo: bits.bor(bits.shl(v.lo, 16), bits.band(g, 0xFFFF)) }

// ── reading bytes ────────────────────────────────────────────────────
//
// Every loop below is a COUNTED `for` over a range known before it
// starts, and every one leaves early by returning.  That is not a
// style preference: `@tier(embedded)` admits three loop shapes and a
// `while i < n` is none of them (SPEC § 12.4), because a bound the
// checker cannot read is a bound nobody has proved.

// The byte at `i`, or `-1` past either end.
@tier(app)
fn byte_of(s: Str, i: Int) -> Int
    // The default is a BINDING and not the literal `-1`, and that
    // is load-bearing: `-1` parses as a negation of `1`, and the
    // compiler's rewrite of `str.byte_at(s, i) ?? d` into the
    // unboxed read only fires for a literal or a variable.  With
    // `?? -1` written directly, every byte read boxes a `?Int` on
    // the heap — one allocation per character scanned.  Filed as
    // `negated-literal-defeats-the-unboxed-byte-read`.
    let miss = 0 - 1
    str.byte_at(s, i) ?? miss

@tier(embedded)
fn is_digit(c: Int) -> Bool
    c >= D_ZERO and c <= D_NINE

// The value of a hex digit, or `-1` when the byte is not one.
@tier(embedded)
fn hex_value(c: Int) -> Int
    if is_digit(c)
        c - D_ZERO
    else if c >= UPPER_A and c <= UPPER_F
        c - UPPER_A + 10
    else if c >= LOWER_A and c <= LOWER_F
        c - LOWER_A + 10
    else
        -1

// The first index in `[from, to)` holding `target`, or `-1`.
@tier(app)
fn find_byte(s: Str, from: Int, to: Int, target: Int) -> Int
    for i in from .. to
        if byte_of(s, i) == target
            return i
    -1

// How many bytes in `[from, to)` equal `target`.
@tier(app)
fn count_byte(s: Str, from: Int, to: Int, target: Int) -> Int
    var n = 0
    for i in from .. to
        if byte_of(s, i) == target
            n = n + 1
    n

// One separated part of a run of text: the half-open range `[start,
// stop)`, with `start == -1` when the part asked for does not exist.
@value
struct Part
    start: Int
    stop: Int

// Part number `idx` of `[from, to)` split on `sep`, counting from 0.
//
// A fresh scan per part, which is `O(parts × bytes)` over a string
// that is at most 45 bytes long and eight parts wide.  The alternative
// is a table of offsets, and a `@value` struct is built whole and
// never assigned into (SPEC § 14.3), so filling one would need a heap
// list — an allocation, to save a scan of forty bytes.
@tier(app)
fn part_at(s: Str, from: Int, to: Int, sep: Int, idx: Int) -> Part
    var seen = 0
    var start = from
    for i in from .. to
        if byte_of(s, i) == sep
            if seen == idx
                return Part { start: start, stop: i }
            seen = seen + 1
            start = i + 1
    if seen == idx
        Part { start: start, stop: to }
    else
        Part { start: -1, stop: -1 }

// ── parsing IPv4 ─────────────────────────────────────────────────────

// The value of one dotted-quad octet in `[from, to)`, or the negated
// error code (`0 - E_...`) naming what is wrong with it.
//
// The order of the checks is CPython's `_parse_octet`, and it is the
// order because the error a caller sees for `0300x` should be the one
// Python reports: not a digit before too long, too long before a
// leading zero, a leading zero before out of range.
@tier(app)
fn octet_value(s: Str, from: Int, to: Int) -> Int
    if to <= from
        return 0 - E_EMPTY_PART
    for i in from .. to
        if not is_digit(byte_of(s, i))
            return 0 - E_BAD_CHARACTER
    if to - from > 3
        return 0 - E_PART_TOO_LONG
    if to - from > 1 and byte_of(s, from) == D_ZERO
        return 0 - E_LEADING_ZERO
    var value = 0
    for i in from .. to
        value = value * 10 + (byte_of(s, i) - D_ZERO)
    if value > 255
        return 0 - E_OCTET_RANGE
    value

// The IPv4 address written in `[from, to)`, or the reason there is
// none.
//
// The primitive `parse_ipv4` is written in terms of.  A caller that
// already has offsets into a larger string — a URL's host span, a
// configuration line — uses this one and copies nothing.
//
// ```novo
// use ip
//
// fn main() [io]
//     let line = "host=192.0.2.1;"
//     let p = ip.parse_ipv4_at(line, 5, 14)
//     println("${p.is_ok()}")          // true
//     println("${p.addr.octet(3)}")    // 1
// ```
pub @tier(app)
fn parse_ipv4_at(s: Str, from: Int, to: Int) -> Ipv4Parse
    if to <= from
        return ipv4_failed(E_EMPTY)
    if count_byte(s, from, to, DOT) != 3
        return ipv4_failed(E_WRONG_PART_COUNT)
    var raw = 0
    for idx in 0 .. 4
        let p = part_at(s, from, to, DOT, idx)
        let v = octet_value(s, p.start, p.stop)
        if v < 0
            return ipv4_failed(0 - v)
        raw = raw * 256 + v
    Ipv4Parse { err: E_OK, addr: Ipv4 { raw: raw } }

// The IPv4 address `s` spells, or the reason it spells none.
//
// Four decimal octets separated by dots and nothing else: no leading
// zeros (`010.0.0.1` is `LeadingZero`, not 8), no shorthand (`127.1`
// is `WrongPartCount`), no surrounding space.  These are the forms
// CPython's `ipaddress` takes, which are narrower than `inet_aton`'s
// and are the ones every modern parser agrees on.
//
// ```novo
// use ip
//
// fn main() [io]
//     let p = ip.parse_ipv4("192.0.2.1")
//     println("${p.is_ok()}")            // true
//     println("${p.addr.is_documentation()}")   // true
// ```
pub @tier(app)
fn parse_ipv4(s: Str) -> Ipv4Parse
    parse_ipv4_at(s, 0, str.len(s))

@tier(embedded)
fn ipv4_failed(code: Int) -> Ipv4Parse
    Ipv4Parse { err: code, addr: Ipv4 { raw: 0 } }

@tier(embedded)
fn ipv6_failed(code: Int) -> Ipv6Parse
    Ipv6Parse { err: code, addr: Ipv6 { hi: 0, lo: 0 } }

// ── parsing IPv6 ─────────────────────────────────────────────────────

// The value of one hex group in `[from, to)`, or the negated error
// code naming what is wrong with it.
//
// Hex digits are checked before length, which is CPython's order in
// `_parse_hextet` and the reason `12g456` is `BadCharacter` rather
// than `PartTooLong`.
@tier(app)
fn hextet_value(s: Str, from: Int, to: Int) -> Int
    if to <= from
        return 0 - E_LONE_COLON
    for i in from .. to
        if hex_value(byte_of(s, i)) < 0
            return 0 - E_BAD_CHARACTER
    if to - from > 4
        return 0 - E_PART_TOO_LONG
    var value = 0
    for i in from .. to
        value = value * 16 + hex_value(byte_of(s, i))
    value

// The IPv6 address written in `[from, to)`, or the reason there is
// none.
//
// THE SHAPE OF THE GRAMMAR
//
// An IPv6 address is eight 16-bit groups, written in hex and separated
// by colons, with one run of zero groups optionally elided as `::`.
// RFC 4291 § 2.2 also lets the last two groups be written as a dotted
// quad, which is how an IPv4-mapped address is spelled.
//
// So the parse is: split on `:`; if the last part holds a `.`, read it
// as an IPv4 address and let it stand for the last two groups; find
// the one empty interior part, which is the `::`; work out how many
// groups it stands for; then read the groups on either side of it.
// That is CPython's `_ip_int_from_string` step for step, including its
// refusals, because agreeing with it exactly is what makes the vector
// suite mean anything.
//
// ```novo
// use ip
//
// fn main() [io]
//     let p = ip.parse_ipv6_at("[2001:db8::1]", 1, 12)
//     println("${p.is_ok()}")        // true
//     println("${p.addr.group(0)}")  // 8193
// ```
pub @tier(app)
fn parse_ipv6_at(s: Str, from: Int, to: Int) -> Ipv6Parse
    if to <= from
        return ipv6_failed(E_EMPTY)
    if find_byte(s, from, to, PERCENT) >= 0
        return ipv6_failed(E_ZONE)

    // `k` parts before an embedded IPv4 tail is expanded, `m` after.
    // Two colons is the minimum any legal form writes.
    let k = count_byte(s, from, to, COLON) + 1
    if k < 3
        return ipv6_failed(E_WRONG_PART_COUNT)

    let last = part_at(s, from, to, COLON, k - 1)
    var v4 = 0
    var embedded = false
    var m = k
    if find_byte(s, last.start, last.stop, DOT) >= 0
        let p4 = parse_ipv4_at(s, last.start, last.stop)
        if not p4.is_ok()
            return ipv6_failed(p4.err)
        let a4: Ipv4 = p4.addr
        v4 = a4.to_int()
        embedded = true
        m = k + 1
    if m > 9
        return ipv6_failed(E_WRONG_PART_COUNT)

    // The `::`, if there is one: the empty part strictly between the
    // ends.  An empty part at either end is a lone `:` unless the `::`
    // claims it, which is what the arithmetic below decides.
    var skip = -1
    for i in 1 .. k - 1
        let p = part_at(s, from, to, COLON, i)
        if p.stop == p.start
            if skip >= 0
                return ipv6_failed(E_REPEATED_DOUBLE_COLON)
            skip = i

    let first = part_at(s, from, to, COLON, 0)
    let first_empty = first.stop == first.start
    // The last part of the EXPANDED list is empty only when there was
    // no dotted tail to expand and the written last part was empty.
    let last_empty = not embedded and last.stop == last.start

    var lead = 0
    var trail = 0
    var zeros = 0
    if skip >= 0
        lead = skip
        trail = m - skip - 1
        if first_empty
            lead = lead - 1
            if lead != 0
                return ipv6_failed(E_LONE_COLON)
        if last_empty
            trail = trail - 1
            if trail != 0
                return ipv6_failed(E_LONE_COLON)
        zeros = 8 - (lead + trail)
        if zeros < 1
            return ipv6_failed(E_WRONG_PART_COUNT)
    else
        if m != 8
            return ipv6_failed(E_WRONG_PART_COUNT)
        if first_empty or last_empty
            return ipv6_failed(E_LONE_COLON)
        lead = 8

    var v = Ipv6 { hi: 0, lo: 0 }
    for i in 0 .. lead
        let g = group_at(s, from, to, k, embedded, v4, i)
        if g < 0
            return ipv6_failed(0 - g)
        v = push_group(v, g)
    for _z in 0 .. zeros
        v = push_group(v, 0)
    for i in m - trail .. m
        let g = group_at(s, from, to, k, embedded, v4, i)
        if g < 0
            return ipv6_failed(0 - g)
        v = push_group(v, g)
    Ipv6Parse { err: E_OK, addr: v }

// Group `idx` of the EXPANDED part list, or the negated error code.
//
// Expanded means: when the written last part was a dotted quad, it is
// gone and the two groups of `v4` stand in its place, so the list is
// one longer than what the colons say.
@tier(app)
fn group_at(s: Str, from: Int, to: Int, k: Int,
            embedded: Bool, v4: Int, idx: Int) -> Int
    if embedded and idx == k - 1
        return bits.band(bits.shr(v4, 16), 0xFFFF)
    if embedded and idx == k
        return bits.band(v4, 0xFFFF)
    let p = part_at(s, from, to, COLON, idx)
    hextet_value(s, p.start, p.stop)

// The IPv6 address `s` spells, or the reason it spells none.
//
// Every form RFC 4291 § 2.2 defines: the eight-group form, the `::`
// elision, and the dotted tail that carries an IPv4 address.  A zone
// identifier (`fe80::1%eth0`) is `ZoneUnsupported` — see the module
// comment for why.
//
// ```novo
// use ip
//
// fn main() [io]
//     let p = ip.parse_ipv6("::ffff:192.0.2.1")
//     println("${p.is_ok()}")                 // true
//     println("${p.addr.is_ipv4_mapped()}")   // true
// ```
pub @tier(app)
fn parse_ipv6(s: Str) -> Ipv6Parse
    parse_ipv6_at(s, 0, str.len(s))

// ── bytes in, bytes out ──────────────────────────────────────────────

// The IPv4 address in the four bytes of `src` at `off`.
//
// Network byte order, which for an address is the order it is written
// in.  A read that runs off the end of `src` takes zeros for the
// missing bytes rather than panicking, so a truncated packet gives a
// wrong address and not a crash.
//
// ```novo
// use ip
//
// fn main() [io]
//     let packet = bytes.from_hex("c0000201")
//     println("${ip.ipv4_from_bytes(packet, 0).to_int()}")   // 3221225985
// ```
pub @tier(app)
fn ipv4_from_bytes(src: Bytes, off: Int) -> Ipv4
    ipv4(bytes.byte_at(src, off) ?? 0,
         bytes.byte_at(src, off + 1) ?? 0,
         bytes.byte_at(src, off + 2) ?? 0,
         bytes.byte_at(src, off + 3) ?? 0)

// Write the four bytes of `a` into `dst` at `off`, and answer the
// buffer.
//
// Allocates nothing: the buffer is the caller's and comes back the
// same one.
pub @tier(app)
fn ipv4_to_bytes(dst: Bytes, off: Int, a: Ipv4) -> Bytes
    var buf = dst
    for i in 0 .. 4
        buf = bytes.set_u8(buf, off + i, a.octet(i))
    buf

// The IPv6 address in the sixteen bytes of `src` at `off`.
//
// Missing bytes read as zero, for the same reason `ipv4_from_bytes`
// does.
pub @tier(app)
fn ipv6_from_bytes(src: Bytes, off: Int) -> Ipv6
    var v = Ipv6 { hi: 0, lo: 0 }
    for i in 0 .. 8
        let g = bits.bor(bits.shl(bytes.byte_at(src, off + 2 * i) ?? 0, 8),
                         bytes.byte_at(src, off + 2 * i + 1) ?? 0)
        v = push_group(v, g)
    v

// Write the sixteen bytes of `a` into `dst` at `off`, and answer the
// buffer.
pub @tier(app)
fn ipv6_to_bytes(dst: Bytes, off: Int, a: Ipv6) -> Bytes
    var buf = dst
    for i in 0 .. 16
        buf = bytes.set_u8(buf, off + i, a.octet(i))
    buf

// ── formatting, into a buffer the caller owns ────────────────────────
//
// `<thing>_len` answers how many bytes `write_<thing>` will write, so
// a caller sizes the buffer once and writes once.  Neither allocates.
// `show` is the module that hands back a `Str`, and it is built out of
// exactly this pair.

// How many decimal digits `v` needs, for `v` in `0 ..= 255`.
@tier(embedded)
fn digits_of(v: Int) -> Int
    if v < 10
        1
    else if v < 100
        2
    else
        3

// How many bytes `write_ipv4` will write for `a`.
pub @tier(embedded)
fn ipv4_len(a: Ipv4) -> Int
    var n = 3
    for i in 0 .. 4
        n = n + digits_of(a.octet(i))
    n

// Write `a` as dotted-decimal into `dst` at `off`, and answer the
// buffer.
//
// No leading zeros — `192.0.2.1`, never `192.000.002.001` — which is
// the only spelling RFC 6943 and every resolver agree reads back as
// the same address.
//
// ```novo
// use ip
//
// fn main() [io]
//     let a = ip.ipv4(192, 0, 2, 1)
//     let buf = ip.write_ipv4(bytes.zeros(ip.ipv4_len(a)), 0, a)
//     println(bytes.to_str(buf))       // 192.0.2.1
// ```
pub @tier(app)
fn write_ipv4(dst: Bytes, off: Int, a: Ipv4) -> Bytes
    var buf = dst
    var at = off
    for i in 0 .. 4
        if i > 0
            buf = bytes.set_u8(buf, at, DOT)
            at = at + 1
        let v = a.octet(i)
        let w = digits_of(v)
        for d in 0 .. w
            buf = bytes.set_u8(buf, at + w - 1 - d, D_ZERO + digit_at(v, d))
        at = at + w
    buf

// Decimal digit `d` of `v`, counting from the least significant.
@tier(embedded)
fn digit_at(v: Int, d: Int) -> Int
    var x = v
    for _i in 0 .. d
        x = x / 10
    x % 10

// Where the run of zero groups that `::` should replace begins, or
// `-1` when there is none to replace.
//
// RFC 5952 § 4.2: the longest run, the leftmost of the longest, and
// never a run of one — `2001:db8:0:1:1:1:1:1` keeps its single zero
// as a `0` rather than becoming `2001:db8::1:1:1:1:1`, which would be
// the same length and one more thing to get wrong.
@tier(embedded)
fn zero_run_start(a: Ipv6) -> Int
    var best_start = -1
    var best_len = 1
    var start = -1
    var len = 0
    for i in 0 .. 8
        if a.group(i) == 0
            if start < 0
                start = i
            len = len + 1
            if len > best_len
                best_len = len
                best_start = start
        else
            start = -1
            len = 0
    best_start

// How long the run at `zero_run_start` is; `0` when there is none.
@tier(embedded)
fn zero_run_len(a: Ipv6) -> Int
    let s = zero_run_start(a)
    if s < 0
        return 0
    var n = 0
    for i in s .. 8
        if a.group(i) != 0
            return n
        n = n + 1
    n

// How many hex digits `g` is written with, for `g` in `0 ..= 65535`.
@tier(embedded)
fn hex_digits_of(g: Int) -> Int
    if g < 0x10
        1
    else if g < 0x100
        2
    else if g < 0x1000
        3
    else
        4

// How many bytes `write_ipv6` will write for `a`.
//
// Computed from the same three decisions `write_ipv6` makes — the
// IPv4-mapped form, where the `::` goes, how wide each group is — so
// the two cannot drift apart without a test noticing (the suite writes
// every generated address and checks the length it was promised).
pub @tier(embedded)
fn ipv6_len(a: Ipv6) -> Int
    if a.is_ipv4_mapped()
        return 7 + ipv4_len(a.mapped_ipv4())
    let rs = zero_run_start(a)
    if rs < 0
        var n = 7
        for i in 0 .. 8
            n = n + hex_digits_of(a.group(i))
        return n
    let after = rs + zero_run_len(a)
    var n = 2
    for i in 0 .. rs
        n = n + hex_digits_of(a.group(i))
        if i > 0
            n = n + 1
    for i in after .. 8
        n = n + hex_digits_of(a.group(i))
        if i > after
            n = n + 1
    n

// Write `a` as text into `dst` at `off`, and answer the buffer.
//
// RFC 5952, all of it:
//
//   § 4.1  leading zeros in a group are suppressed
//   § 4.2  the longest run of zero groups is replaced by `::`, the
//          leftmost when two are equally long, and never a run of one
//   § 4.3  hex digits are lower case
//   § 5    an IPv4-mapped address is written `::ffff:192.0.2.1`
//
// § 5 is the one place this disagrees with CPython, which writes
// `::ffff:c000:201` — its formatter has no mixed-notation case at all.
// The RFC is what a reader and every other implementation expect, so
// it is what this writes; the vector suite pins both spellings against
// each other so the difference is a decision on the record.
//
// ```novo
// use ip
//
// fn main() [io]
//     let p = ip.parse_ipv6("2001:0DB8:0000:0000:0000:0000:0000:0001")
//     let a: Ipv6 = p.addr
//     let buf = ip.write_ipv6(bytes.zeros(ip.ipv6_len(a)), 0, a)
//     println(bytes.to_str(buf))       // 2001:db8::1
// ```
pub @tier(app)
fn write_ipv6(dst: Bytes, off: Int, a: Ipv6) -> Bytes
    if a.is_ipv4_mapped()
        var head = dst
        for j in 0 .. 7
            head = bytes.set_u8(head, off + j, mapped_prefix_byte(j))
        return write_ipv4(head, off + 7, a.mapped_ipv4())
    let rs = zero_run_start(a)
    var buf = dst
    var at = off
    // The groups before the `::`, joined by `:`.  When there is no run
    // to elide, `rs` is `-1`, this loop writes nothing and the second
    // one writes all eight.
    for i in 0 .. rs
        if i > 0
            buf = bytes.set_u8(buf, at, COLON)
            at = at + 1
        let g = a.group(i)
        buf = write_hex(buf, at, g)
        at = at + hex_digits_of(g)
    if rs >= 0
        buf = bytes.set_u8(buf, at, COLON)
        buf = bytes.set_u8(buf, at + 1, COLON)
        at = at + 2
    let tail_from = if rs < 0 then 0 else rs + zero_run_len(a)
    for i in tail_from .. 8
        if i > tail_from
            buf = bytes.set_u8(buf, at, COLON)
            at = at + 1
        let g = a.group(i)
        buf = write_hex(buf, at, g)
        at = at + hex_digits_of(g)
    buf

// Write `g` as lower-case hex, shortest form, at `at`.
@tier(app)
fn write_hex(dst: Bytes, at: Int, g: Int) -> Bytes
    var buf = dst
    let w = hex_digits_of(g)
    for d in 0 .. w
        buf = bytes.set_u8(buf, at + w - 1 - d, hex_char(nibble_at(g, d)))
    buf

// Byte `j` of the seven-byte `::ffff:` prefix.
@tier(embedded)
fn mapped_prefix_byte(j: Int) -> Int
    if j == 0 or j == 1
        COLON
    else if j == 6
        COLON
    else
        LOWER_F

// Hex nibble `d` of `g`, counting from the least significant.
@tier(embedded)
fn nibble_at(g: Int, d: Int) -> Int
    bits.band(bits.shr(g, 4 * d), 0xF)

// The lower-case ASCII byte for a nibble.
@tier(embedded)
fn hex_char(n: Int) -> Int
    if n < 10
        D_ZERO + n
    else
        LOWER_A + n - 10
